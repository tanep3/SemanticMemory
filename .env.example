# Database Paths
SQLITE_PATH=./datas/semantic_memory.db
CHROMA_PATH=./datas/chroma/

# Server Port (used in uvicorn)
APP_PORT=6001

# Embedding Model (SentenceTransformer)
SBERT_MODEL=cl-nagoya/ruri-v3-70m
SBERT_DEVICE=cpu

# Semantic Search Settings
COSINE_THRESHOLD=0.5
RECALL_LIMIT=10

# LLM Settings (Ollama)
LLM_MODEL=hf.co/SakanaAI/TinySwallow-1.5B-Instruct-GGUF:Q8_0
OLLAMA_URL=http://host.docker.internal:11434
SYSTEM_PROMPT=以下のテキストを日本語で簡潔に要約してください。

# UI Authentication (v2.0.0)
# Set both to enable Basic Auth for Neural Dive UI
# Leave empty or unset for no authentication
UI_USER=
UI_PASS=


# Client API Timeout (seconds)
API_TIMEOUT=30
